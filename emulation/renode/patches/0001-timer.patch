+            {
+                if(channel.Timer.Frequency != frequency) channel.Timer.Frequency = frequency;
+            }
+            Enabled = clockEnabled && !IsEncoderMode && enableRequested && autoReloadValue > 0;
+            UpdateCaptureCompareTimers();
+        }
+
+        private void ApplyPreloads()
+        {
+            Limit = (ulong)autoReloadValue + 1;
