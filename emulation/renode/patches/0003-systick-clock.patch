+
+    // STM32F407 routes HCLK or HCLK/8 into the Cortex-M4 SysTick. Keep the
+    // installed NVIC's counter, pending exceptions and interrupt delivery.
+    public sealed class STM32F407SysTickClock : IPeripheral
+    {
+        public STM32F407SysTickClock(NVIC nvic)
+        {
+            this.nvic = nvic;
+            nvic.RegisterCollection.AddBeforeWriteHook(Control, (_, value) =>
+            {
+                processorClock = (value & ClockSourceBit) != 0;
+                UpdateDivider();
+                return null;
+            });
+            nvic.RegisterCollection.AddAfterReadHook(Control, (_, value) =>
+                (value & ~ClockSourceBit) | (processorClock ? ClockSourceBit : 0u));
+            Reset();
+        }
+
+        public void Reset()
+        {
+            processorClock = false;
+            UpdateDivider();
+        }
+
+        public void SetHclk(ulong frequency)
+        {
+            if(nvic.Frequency != frequency)
+            {
+                nvic.Frequency = frequency;
+            }
+            UpdateDivider();
+        }
+
+        private void UpdateDivider()
+        {
+            var divider = processorClock ? 1UL : 8UL;
+            if(nvic.Divider != divider)
+            {
+                nvic.Divider = divider;
+            }
+        }
+
+        private const long Control = 0x10;
+        private const uint ClockSourceBit = 1u << 2;
+        private readonly NVIC nvic;
+        private bool processorClock;
+    }
+}
