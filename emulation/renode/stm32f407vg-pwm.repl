// Signal-only STM32F407VGT6 bench. No robot, motor model or RAM observer.
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000
ccm: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x10000
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    IRQ -> cpu@0
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic
gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x40020000, +0x400>
    modeResetValue: 0xA8000000
    numberOfAFs: 16
gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x40020400, +0x400>
    modeResetValue: 0x00000280
    numberOfAFs: 16
gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x40020800, +0x400>
    numberOfAFs: 16
gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x40021000, +0x400>
    numberOfAFs: 16
flash_controller: MTD.STM32F4_FlashController @ sysbus 0x40023C00
    flash: flash
pwr: Miscellaneous.STM32_PWR @ sysbus 0x40007000
rtc: Timers.STM32F4_RTC @ sysbus 0x40002800
systickClock: Miscellaneous.STM32F407SysTickClock @ sysbus
    nvic: nvic
rcc: Miscellaneous.QualifiedSTM32RCC @ sysbus 0x40023800
    systickClock: systickClock
    rtcPeripheral: rtc
    timer2: timer2
    timer3: timer3
    timer4: timer4
timer2: Timers.QualifiedSTM32Timer @ sysbus 0x40000000
    frequency: 16000000
    initialLimit: 0xFFFFFFFF
    -> nvic@28 | probe@10
timer3: Timers.QualifiedSTM32Timer @ sysbus 0x40000400
    frequency: 16000000
    initialLimit: 0xFFFF
    0 -> gpioPortA#6@2
    1 -> gpioPortA#7@2
    2 -> gpioPortB#0@2
    3 -> gpioPortB#1@2
timer4: Timers.QualifiedSTM32Timer @ sysbus 0x40000800
    frequency: 16000000
    initialLimit: 0xFFFF
// Initialized by the firmware, but never started. APB2 clock propagation is outside this bench.
timer9: Timers.QualifiedSTM32Timer @ sysbus 0x40014000
    frequency: 16000000
    initialLimit: 0xFFFF
    0 -> gpioPortE#5@3
    1 -> gpioPortE#6@3
pwmInput0: GPIOPort.STM32AFInput @ timer2
    port: gpioPortA
    pin: 0
    alternateFunction: 1
    IRQ -> timer2@0
pwmInput2: GPIOPort.STM32AFInput @ timer2
    port: gpioPortA
    pin: 2
    alternateFunction: 1
    IRQ -> timer2@2
gpioPortA:
    0 -> pwmInput0@0 | probe@11
    2 -> pwmInput2@0 | probe@12
    6 -> probe@0
    7 -> probe@1
gpioPortB:
    0 -> probe@2
    1 -> probe@3
    3 -> probe@8
    5 -> probe@9
gpioPortC:
    0 -> probe@4
    1 -> probe@5
    2 -> probe@6
    3 -> probe@7
probe: Miscellaneous.PwmBenchProbe @ sysbus
// Cortex-M4 peripheral bit-band alias, also used by Renode's stock STM32F4 platform.
bitbandPeripherals: Miscellaneous.BitBanding @ sysbus <0x42000000, +0x2000000>
    peripheralBase: 0x40000000
